/* =====================================================================
   PIM IV - Sistema de Chamados (Help Desk)
   Script SQL Server CORRIGIDO E COMENTADO PARA ESTUDO
   ---------------------------------------------------------------------
   O que mudou em relacao ao original:
   - Script re-executavel (nao quebra se rodar duas vezes)
   - GO separando os lotes (CREATE PROCEDURE/TRIGGER exigem isso)
   - Datas no formato seguro 'YYYY-MM-DDTHH:MM:SS' (independe do idioma)
   - Usuarios inseridos UMA vez so (sem violar a chave primaria)
   - 'Media' sem acento no CHECK (evita problema de codificacao)
   - Procedure renomeada: sp_ -> usp_ (sp_ e reservado ao sistema)
   - Trigger de auditoria usando SESSION_CONTEXT
   - LGPD: CPF criptografado, consentimento, auditoria completa,
           view mascarada, perfis de permissao
   - IA: SolucoesIA ligada a categoria, com palavras-chave e contador
   ===================================================================== */


/* ---------------------------------------------------------------------
   1) BANCO DE DADOS
   DB_ID retorna NULL se o banco nao existe; so cria se for o caso.
   --------------------------------------------------------------------- */
IF DB_ID('pim') IS NULL
    CREATE DATABASE pim;
GO

USE pim;
GO


/* ---------------------------------------------------------------------
   2) TABELAS
   IF OBJECT_ID(...) IS NULL  ->  so cria se a tabela ainda nao existe.
   A ordem importa: tabelas referenciadas (FK) vem antes das que referenciam.
   --------------------------------------------------------------------- */

-- SETORES (tabela de apoio)
IF OBJECT_ID('dbo.Setores', 'U') IS NULL
CREATE TABLE dbo.Setores (
    id_setor    INT IDENTITY(1,1) PRIMARY KEY,
    nome_setor  VARCHAR(50) NOT NULL UNIQUE
);

-- CATEGORIAS (tabela de apoio)
IF OBJECT_ID('dbo.Categorias', 'U') IS NULL
CREATE TABLE dbo.Categorias (
    id_categoria    INT IDENTITY(1,1) PRIMARY KEY,
    nome_categoria  VARCHAR(50) NOT NULL UNIQUE
);

-- USUARIOS
-- 'senha' guarda apenas o HASH, nunca a senha pura.
-- 'cpf_criptografado' guarda o CPF ja criptografado pela aplicacao (LGPD).
-- 'ativo' = exclusao logica: desativa em vez de apagar (LGPD).
IF OBJECT_ID('dbo.Usuarios', 'U') IS NULL
CREATE TABLE dbo.Usuarios (
    id_usuario         INT IDENTITY(1,1) PRIMARY KEY,
    nome               VARCHAR(50)  NOT NULL,
    email              VARCHAR(100) NOT NULL UNIQUE,
    telefone           VARCHAR(15)  NOT NULL,
    senha              VARCHAR(255) NOT NULL,
    cpf_criptografado  VARBINARY(256) NULL,
    id_setor           INT          NOT NULL,
    perfil             VARCHAR(20)  NOT NULL
        CONSTRAINT CK_Usuarios_perfil CHECK (perfil IN ('Usuario', 'Analista', 'Admin')),
    data_cadastro      DATETIME     NOT NULL CONSTRAINT DF_Usuarios_data DEFAULT GETDATE(),
    ativo              BIT          NOT NULL CONSTRAINT DF_Usuarios_ativo DEFAULT 1,
    CONSTRAINT FK_Usuarios_Setores FOREIGN KEY (id_setor) REFERENCES dbo.Setores(id_setor)
);

-- CONSENTIMENTOS (LGPD): registra o aceite do termo de uso/privacidade
IF OBJECT_ID('dbo.Consentimentos', 'U') IS NULL
CREATE TABLE dbo.Consentimentos (
    id_consentimento  INT IDENTITY(1,1) PRIMARY KEY,
    id_usuario        INT          NOT NULL,
    versao_termo      VARCHAR(10)  NOT NULL,            -- ex.: '1.0'
    aceito            BIT          NOT NULL,
    data_aceite       DATETIME     NOT NULL CONSTRAINT DF_Consent_data DEFAULT GETDATE(),
    ip_origem         VARCHAR(50)  NULL,
    CONSTRAINT FK_Consent_Usuarios FOREIGN KEY (id_usuario) REFERENCES dbo.Usuarios(id_usuario)
);

-- CHAMADOS (tabela central)
-- Duas FKs para Usuarios: quem abriu (id_usuario) e quem atende (id_analista).
-- O CHECK final impede um chamado 'Encerrado' sem data de fechamento.
IF OBJECT_ID('dbo.Chamados', 'U') IS NULL
CREATE TABLE dbo.Chamados (
    id_chamado             INT IDENTITY(1,1) PRIMARY KEY,
    id_usuario             INT          NOT NULL,
    id_analista            INT          NULL,
    titulo                 VARCHAR(100) NOT NULL,
    descricao              VARCHAR(500) NOT NULL,
    id_categoria           INT          NOT NULL,
    prioridade             VARCHAR(10)  NOT NULL
        CONSTRAINT CK_Chamados_prioridade CHECK (prioridade IN ('Baixa', 'Media', 'Alta')),
    status                 VARCHAR(20)  NOT NULL
        CONSTRAINT CK_Chamados_status CHECK (status IN ('Aberto', 'Em analise', 'Aguardando Resposta', 'Encerrado')),
    data_abertura          DATETIME     NOT NULL CONSTRAINT DF_Chamados_abertura DEFAULT GETDATE(),
    data_fechamento        DATETIME     NULL,
    solucao_informada      VARCHAR(500) NULL,
    avaliacao_atendimento  INT          NULL
        CONSTRAINT CK_Chamados_avaliacao CHECK (avaliacao_atendimento BETWEEN 1 AND 5),
    CONSTRAINT FK_Chamados_Usuario   FOREIGN KEY (id_usuario)   REFERENCES dbo.Usuarios(id_usuario),
    CONSTRAINT FK_Chamados_Analista  FOREIGN KEY (id_analista)  REFERENCES dbo.Usuarios(id_usuario),
    CONSTRAINT FK_Chamados_Categoria FOREIGN KEY (id_categoria) REFERENCES dbo.Categorias(id_categoria),
    CONSTRAINT CK_Chamados_fechamento
        CHECK (status <> 'Encerrado' OR data_fechamento IS NOT NULL)
);

-- SOLUCOESIA (base da IA simulada e da FAQ dinamica)
-- id_categoria: permite filtrar sugestoes por categoria do chamado.
-- palavras_chave: usadas pela IA para casar o texto do chamado com a solucao.
-- qtd_utilizacoes: contador para ordenar a FAQ pelas solucoes mais usadas.
IF OBJECT_ID('dbo.SolucoesIA', 'U') IS NULL
CREATE TABLE dbo.SolucoesIA (
    id_solucao          INT IDENTITY(1,1) PRIMARY KEY,
    id_categoria        INT          NULL,
    descricao_problema  VARCHAR(500) NOT NULL,
    palavras_chave      VARCHAR(200) NULL,
    solucao_sugerida    VARCHAR(500) NOT NULL,
    qtd_utilizacoes     INT          NOT NULL CONSTRAINT DF_SolIA_qtd DEFAULT 0,
    data_criacao        DATETIME     NOT NULL CONSTRAINT DF_SolIA_data DEFAULT GETDATE(),
    CONSTRAINT FK_SolIA_Categoria FOREIGN KEY (id_categoria) REFERENCES dbo.Categorias(id_categoria)
);

-- LOGSAUDITORIA (LGPD)
-- Usuario afetado e executor aceitam NULL: assim da para registrar, por
-- exemplo, uma tentativa de login com e-mail que nao existe.
-- registro_id + detalhes dizem QUAL registro mudou e O QUE mudou.
IF OBJECT_ID('dbo.LogsAuditoria', 'U') IS NULL
CREATE TABLE dbo.LogsAuditoria (
    id_log               INT IDENTITY(1,1) PRIMARY KEY,
    id_usuario_afetado   INT           NULL,
    id_usuario_executor  INT           NULL,
    acao                 VARCHAR(100)  NOT NULL,
    tabela_afetada       VARCHAR(100)  NULL,
    registro_id          INT           NULL,
    detalhes             NVARCHAR(500) NULL,
    data_hora            DATETIME      NOT NULL CONSTRAINT DF_Logs_data DEFAULT GETDATE(),
    ip_origem            VARCHAR(50)   NULL,
    CONSTRAINT FK_Logs_Afetado  FOREIGN KEY (id_usuario_afetado)  REFERENCES dbo.Usuarios(id_usuario),
    CONSTRAINT FK_Logs_Executor FOREIGN KEY (id_usuario_executor) REFERENCES dbo.Usuarios(id_usuario)
);
