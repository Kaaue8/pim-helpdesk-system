/* ---------------------------------------------------------------------
   4) PROCEDURE DE LOG
   usp_ (e nao sp_): o prefixo sp_ e reservado ao sistema e faz o SQL Server
   procurar primeiro no banco master.
   CREATE OR ALTER: cria ou atualiza, permitindo rodar o script varias vezes.
   Precisa ser a primeira instrucao do lote (por isso o GO antes).
   --------------------------------------------------------------------- */
CREATE OR ALTER PROCEDURE dbo.usp_RegistrarLog
    @p_id_usuario_afetado  INT           = NULL,
    @p_id_usuario_executor INT           = NULL,
    @p_acao                VARCHAR(100),
    @p_tabela_afetada      VARCHAR(100)  = NULL,
    @p_registro_id         INT           = NULL,
    @p_detalhes            NVARCHAR(500) = NULL,
    @p_ip_origem           VARCHAR(50)   = NULL
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.LogsAuditoria
        (id_usuario_afetado, id_usuario_executor, acao, tabela_afetada, registro_id, detalhes, ip_origem)
    VALUES
        (@p_id_usuario_afetado, @p_id_usuario_executor, @p_acao, @p_tabela_afetada, @p_registro_id, @p_detalhes, @p_ip_origem);
END
GO


/* ---------------------------------------------------------------------
   5) TRIGGER DE AUDITORIA DE CHAMADOS
   Como o banco sabe QUEM (usuario da aplicacao) fez a alteracao?
   A API, ao abrir a conexao, executa:
       EXEC sp_set_session_context @key = N'id_usuario', @value = 5;
       EXEC sp_set_session_context @key = N'ip_origem',  @value = '192.168.0.10';
   O trigger le esses valores com SESSION_CONTEXT().
   Vantagem: registra QUALQUER alteracao, inclusive as feitas direto no banco.
   'inserted' = linhas depois do UPDATE; 'deleted' = linhas antes do UPDATE.
   --------------------------------------------------------------------- */
CREATE OR ALTER TRIGGER dbo.trg_Chamados_Auditoria
ON dbo.Chamados
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @executor INT         = TRY_CAST(SESSION_CONTEXT(N'id_usuario') AS INT);
    DECLARE @ip       VARCHAR(50) = TRY_CAST(SESSION_CONTEXT(N'ip_origem')  AS VARCHAR(50));

    INSERT INTO dbo.LogsAuditoria
        (id_usuario_afetado, id_usuario_executor, acao, tabela_afetada, registro_id, detalhes, ip_origem)
    SELECT
        i.id_usuario,
        @executor,
        'UPDATE_CHAMADO',
        'Chamados',
        i.id_chamado,
        CONCAT('status: ', d.status, ' -> ', i.status,
               '; analista: ', ISNULL(CAST(d.id_analista AS VARCHAR(10)), '-'),
               ' -> ',         ISNULL(CAST(i.id_analista AS VARCHAR(10)), '-')),
        @ip
    FROM inserted i
    JOIN deleted  d ON d.id_chamado = i.id_chamado
    WHERE d.status <> i.status
       OR ISNULL(d.id_analista, 0) <> ISNULL(i.id_analista, 0)
       OR ISNULL(d.solucao_informada, '') <> ISNULL(i.solucao_informada, '');
END
GO


/* ---------------------------------------------------------------------
   6) VIEW COM DADOS MASCARADOS (LGPD)
   Telas e relatorios devem ler desta view, e nao da tabela Usuarios.
   Ex.: bruno.pereira@gmail.com -> b***@gmail.com | 11986546372 -> (11) *****-6372
   --------------------------------------------------------------------- */
CREATE OR ALTER VIEW dbo.vw_UsuariosMascarados
AS
SELECT
    id_usuario,
    nome,
    LEFT(email, 1) + '***' + SUBSTRING(email, CHARINDEX('@', email), LEN(email)) AS email_mascarado,
    '(' + LEFT(telefone, 2) + ') *****-' + RIGHT(telefone, 4)                    AS telefone_mascarado,
    id_setor,
    perfil,
    ativo
FROM dbo.Usuarios;
GO


/* ---------------------------------------------------------------------
   7) PERFIS E PERMISSOES (LGPD: principio do menor privilegio)
   Cada perfil acessa so o necessario. Ninguem apaga logs.
   --------------------------------------------------------------------- */
IF DATABASE_PRINCIPAL_ID('role_usuario')  IS NULL CREATE ROLE role_usuario;
IF DATABASE_PRINCIPAL_ID('role_analista') IS NULL CREATE ROLE role_analista;
IF DATABASE_PRINCIPAL_ID('role_admin')    IS NULL CREATE ROLE role_admin;
GO

-- Usuario comum: abre e consulta chamados; ve usuarios apenas pela view mascarada
GRANT SELECT, INSERT ON dbo.Chamados               TO role_usuario;
GRANT SELECT         ON dbo.vw_UsuariosMascarados  TO role_usuario;
GRANT SELECT         ON dbo.Categorias             TO role_usuario;
GRANT SELECT         ON dbo.Setores                TO role_usuario;
GRANT SELECT         ON dbo.SolucoesIA             TO role_usuario;
GRANT INSERT         ON dbo.Consentimentos         TO role_usuario;

-- Analista: tambem atualiza chamados e consulta a base da IA
GRANT SELECT, INSERT, UPDATE ON dbo.Chamados       TO role_analista;
GRANT SELECT, UPDATE         ON dbo.SolucoesIA     TO role_analista;
GRANT SELECT ON dbo.vw_UsuariosMascarados          TO role_analista;
GRANT SELECT ON dbo.Categorias                     TO role_analista;
GRANT SELECT ON dbo.Setores                        TO role_analista;

-- Admin: gerencia usuarios, consulta logs; NAO pode apagar nem alterar logs
GRANT SELECT, INSERT, UPDATE ON dbo.Usuarios       TO role_admin;
GRANT SELECT, INSERT, UPDATE ON dbo.Chamados       TO role_admin;
GRANT SELECT ON dbo.LogsAuditoria                  TO role_admin;
GRANT SELECT ON dbo.Consentimentos                 TO role_admin;
GRANT EXECUTE ON dbo.usp_RegistrarLog              TO role_admin, role_analista, role_usuario;
DENY  DELETE, UPDATE ON dbo.LogsAuditoria          TO role_admin;
GO


